# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / distribution ---
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg

# --- PyInstaller ---
# Auto-generated on each build from the command-line options -- only
