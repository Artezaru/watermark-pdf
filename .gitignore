# for something the CLI flags can't express.
*.spec

# --- Virtual environments ---
.venv/
venv/
env/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- OS-specific ---
.DS_Store
Thumbs.db
